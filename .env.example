# Copy to .env and adjust. Docker Compose reads it for every service.
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=DAGonWeb Admin

# Database (SQLite in ./instance by default). With the Redis overlay and
# several workers use PostgreSQL or MySQL and set the URL here:
# DATABASE_URL=postgresql+psycopg2://dagonweb:dagonweb@db:5432/dagonweb

# Any administration setting can be pinned with DAGONWEB_<KEY>, for example:
# DAGONWEB_EXECUTION_BACKEND=redis
# REDIS_URL=redis://redis:6379/0
# DAGONWEB_SITE_NAME=Parthenope Workflows
# DAGONWEB_LLM_ENABLED=true
# OPENAI_API_KEY=sk-...
# DAGONWEB_SMTP_HOST=smtp.example.org

# HPC cluster mode (docker-compose.hpc.yml, docs/hpc.md): encrypts the users'
# cluster SSH keys. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# HPC_KEY_SECRET=
