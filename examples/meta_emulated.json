    "wordcount": {
      "command": null,
      "dagonweb": {
        "config": {
          "engine": "nextflow",
          "engine_options": {
            "profile": "standard"
          },
          "environment": {},
          "inputs": {
            "text": "workflow:///prepare/data/text.txt",
            "top": 3
          },
          "outputs": {
            "counts": {
              "path": "counts.tsv",
              "source": "results/counts.tsv"
            }
          },
          "staging": "copy",
          "workflow": "main.nf",
          "workflow_source": "// Word count in Nextflow. Under portable emulation DAGonStar's mock engine\n// stands in for Nextflow and writes a placeholder for each declared output.\nparams.text = null\nparams.top = 10\n\nprocess COUNT {\n    publishDir 'results', mode: 'copy'\n\n    input:\n    path text\n\n    output:\n    path 'counts.tsv'\n\n    script:\n    \"\"\"\n    tr -s '[:space:]' '\\\\n' < $text | sort | uniq -c | sort -rn | head -n ${params.top} | awk '{print \\$2 \"\\\\t\" \\$1}' > counts.tsv\n    \"\"\"\n}\n\nworkflow {\n    COUNT(file(params.text))\n}\n"
        },
        "x": 420,
        "y": 200
      },
